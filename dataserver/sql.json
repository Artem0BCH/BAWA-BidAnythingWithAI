{
    "users": {
        "get_all": {
            "sql": "SELECT * FROM users"
        },
        "get_by_id": {
            "sql": "SELECT * FROM users WHERE user_id=?"
        },
        "insert": {
            "sql": "INSERT INTO users (user_id, username, email, password, created_at, account_status) VALUES (?,?,?,?,?,?)",
            "parameters": [
                "user_id",
                "username",
                "email",
                "password",
                "created_at",
                "account_status"
            ]
        },
        "update": {
            "sql": "UPDATE users SET username=?, email=?, password=?, created_at=?, account_status=? WHERE user_id=?",
            "parameters": [
                "username",
                "email",
                "password",
                "created_at",
                "account_status",
                "user_id"
            ]
        },
        "primary_key": "user_id"
    }
}